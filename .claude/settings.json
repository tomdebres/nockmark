{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/verify-nudge\"; [ ! -x \"$h\" ] || exec \"$h\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/verify-nudge\"; [ ! -x \"$h\" ] || exec \"$h\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
